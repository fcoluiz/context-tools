{
  "description": "Development hooks for working on this repository with Codex: same set as hooks/codex-hooks.json, pointing at the source scripts/ instead of an installed copy.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" session-write-journal.mjs --session-start"
          },
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" context-maps.mjs --session-start"
          },
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" context-docs.mjs --session-start"
          },
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" handoff.mjs --session-start"
          },
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" codex-md-hint.mjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" context-docs.mjs --prompt-audit",
            "timeout": 10,
            "statusMessage": "Checking named files against context maps"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" context-docs.mjs --stop-report",
            "timeout": 35,
            "statusMessage": "Reviewing project context"
          },
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" coupling.mjs --changed --hook"
          },
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" handoff.mjs --stop-report"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" session-write-journal.mjs --pre-tool-use",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" pre-tool.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/codex-hook.mjs\" session-write-journal.mjs --post-tool-use",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
